# ── 北辰 x-BeiChen 环境变量示例 ─────────────────────────────
# 复制为 .env 后按需修改；配置优先级：环境变量 > config.{env}.yaml > config.yaml > 代码默认值

# 运行环境（development / testing / production）
APP_ENV=development

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=6666
SERVER_DEBUG=true

# Logging（console 彩色 / json 结构化；文件始终 JSON）
LOGGING_LEVEL=INFO
LOGGING_FORMAT=console

# Database（骨架默认关闭；开启需配齐以下连接信息）
DATABASE_ENABLED=false
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_DATABASE=beichen

# Redis（骨架默认关闭；开启后用于缓存/事件总线/Agent 检查点）
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379

# AI / LLM（配置 API Key 后自动从 Mock 切换到真实模型）
AI_ENABLED=true
AI_LLM_PROVIDER=openai_compat
AI_LLM_BASE_URL=https://api.xiaomimimo.com/v1
AI_LLM_API_KEY=
AI_LLM_MODEL=mimo-v2.6-pro

# Agent 编排
AGENT_ENABLED=true
AGENT_CHECKPOINT=memory            # memory（开发）/ redis（生产）
AGENT_TASK_MAX_RETRIES=3
AGENT_TASK_TIMEOUT_SECONDS=300
AGENT_EVENT_BUS_STREAM=beichen:agent:events

# 定时任务（开启后每 15 分钟触发一轮数据监控巡检）
BEICHEN_SCHEDULER_ENABLED=false

# 广告审批系统对接（二期，资金写操作审批闸门）
APPROVAL_ENABLED=true
APPROVAL_BASE_URL=http://approval-service:8080
APPROVAL_SERVICE_TOKEN=
