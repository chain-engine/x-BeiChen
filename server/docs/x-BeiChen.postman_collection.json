{
  "info": {
    "_postman_id": "98b3803c-7d06-402d-87f8-c3f0298ff9e0",
    "name": "北辰（BeiChen）",
    "description": "北辰 x-BeiChen 后端接口集合（FastAPI）。\n\n目录结构：api → v1 → 接口分类 → 具体接口。\n完整服务前缀为 /api/admin/v1，其中固定段 /admin 已并入 base_url 变量。\n\n变量说明：\n- base_url：服务地址（默认本地开发 http://localhost:8866/api/admin/v1）\n- task_id / event_id：路径参数示例值，调试时替换为真实 ID\n\n接口分类（11 个）：健康检查 2、认证 2（预留 501）、Agent 任务管理 7。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "api",
      "description": "接口根目录（对应 URL 前缀 /api）。",
      "item": [
        {
          "name": "v1",
          "description": "v1 版本目录（对应 URL 前缀 /api/admin/v1）。",
          "item": [
            {
              "name": "健康检查",
              "description": "服务存活与版本探针，不依赖数据库，供负载均衡 / 运维监控使用。",
              "item": [
                {
                  "name": "GET /health 服务健康检查",
                  "request": {
                    "method": "GET",
                    "header": [],
                    "url": {
                      "raw": "{{base_url}}/health",
                      "host": [
                        "{{base_url}}"
                      ],
                      "path": [
                        "health"
                      ]
                    },
                    "description": "返回服务存活状态及依赖组件（database / redis / agent_runtime）状态，供负载均衡与运维探针使用，不依赖数据库。"
                  },
                  "response": []
                },
                {
                  "name": "GET /version 应用版本信息",
                  "request": {
                    "method": "GET",
                    "header": [],
                    "url": {
                      "raw": "{{base_url}}/version",
                      "host": [
                        "{{base_url}}"
                      ],
                      "path": [
                        "version"
                      ]
                    },
                    "description": "返回 app_id / app_name / version / python_requires。"
                  },
                  "response": []
                }
              ]
            },
            {
              "name": "认证",
              "description": "认证接口为生产级特性，骨架阶段返回 501（预留：JWT + RBAC）。",
              "item": [
                {
                  "name": "POST /auth/login 登录（预留）",
                  "request": {
                    "method": "POST",
                    "header": [
                      {
                        "key": "Content-Type",
                        "value": "application/json"
                      }
                    ],
                    "body": {
                      "mode": "raw",
                      "raw": "{\n    \"username\": \"admin\",\n    \"password\": \"changeme\"\n}"
                    },
                    "url": {
                      "raw": "{{base_url}}/auth/login",
                      "host": [
                        "{{base_url}}"
                      ],
                      "path": [
                        "auth",
                        "login"
                      ]
                    },
                    "description": "预留接口，当前返回 501 Not Implemented。body 为未来形态示例，现不被消费。"
                  },
                  "response": []
                },
                {
                  "name": "POST /auth/refresh 刷新令牌（预留）",
                  "request": {
                    "method": "POST",
                    "header": [
                      {
                        "key": "Content-Type",
                        "value": "application/json"
                      }
                    ],
                    "body": {
                      "mode": "raw",
                      "raw": "{\n    \"refresh_token\": \"\"\n}"
                    },
                    "url": {
                      "raw": "{{base_url}}/auth/refresh",
                      "host": [
                        "{{base_url}}"
                      ],
                      "path": [
                        "auth",
                        "refresh"
                      ]
                    },
                    "description": "令牌刷新预留接口，当前返回 501。"
                  },
                  "response": []
                }
              ]
            },
            {
              "name": "Agent 任务管理",
              "description": "Agent 编排管理接口：注册表查询、任务提交/列表/详情、人工接管 resume、协作事件查询。",
              "item": [
                {
                  "name": "GET /agents/specs Agent 注册表列表",
                  "request": {
                    "method": "GET",
                    "header": [],
                    "url": {
                      "raw": "{{base_url}}/agents/specs",
                      "host": [
                        "{{base_url}}"
                      ],
                      "path": [
                        "agents",
                        "specs"
                      ]
                    },
                    "description": "返回当前已注册 Agent 清单（type / name / description / enabled），无需查库。当前注册表为空，注册新 Agent 后自动列出。"
                  },
                  "response": []
                },
                {
                  "name": "POST /tasks 提交 Agent 任务",
                  "request": {
                    "method": "POST",
                    "header": [
                      {
                        "key": "Content-Type",
                        "value": "application/json"
                      }
                    ],
                    "body": {
                      "mode": "raw",
                      "raw": "{\n    \"task_type\": \"your_agent_type\",\n    \"payload\": {\n        \"query\": \"...\"\n    }\n}"
                    },
                    "url": {
                      "raw": "{{base_url}}/tasks",
                      "host": [
                        "{{base_url}}"
                      ],
                      "path": [
                        "tasks"
                      ]
                    },
                    "description": "提交任务并同步执行。\n\ntask_type 显式指定则直接路由；留空时由 LLM 根据 query/payload 自然语言动态选择。\n\npayload 按最终路由到的 Agent 选用对应字段（各 Agent 自定义结构）。当前注册表为空：提交 AgentType 枚举之外的类型返回 422；枚举但未注册的类型返回「任务类型未注册 Agent」。"
                  },
                  "response": []
                },
                {
                  "name": "GET /tasks 任务列表",
                  "request": {
                    "method": "GET",
                    "header": [],
                    "url": {
                      "raw": "{{base_url}}/tasks?page=1&page_size=20",
                      "host": [
                        "{{base_url}}"
                      ],
                      "path": [
                        "tasks"
                      ],
                      "query": [
                        {
                          "key": "status",
                          "value": "",
                          "disabled": true,
                          "description": "按任务状态过滤：pending/assigned/running/success/failed/waiting_human/abandoned 等"
                        },
                        {
                          "key": "task_type",
                          "value": "",
                          "disabled": true,
                          "description": "按任务类型过滤：content/customer_service/security/data_analysis/data_monitor"
                        },
                        {
                          "key": "page",
                          "value": "1"
                        },
                        {
                          "key": "page_size",
                          "value": "20"
                        }
                      ]
                    },
                    "description": "分页查询任务列表（管理后台任务面板）。status / task_type 两个可选过滤参数在 Params 中勾选启用。"
                  },
                  "response": []
                },
                {
                  "name": "GET /tasks/{task_id} 任务详情",
                  "request": {
                    "method": "GET",
                    "header": [],
                    "url": {
                      "raw": "{{base_url}}/tasks/{{task_id}}",
                      "host": [
                        "{{base_url}}"
                      ],
                      "path": [
                        "tasks",
                        "{{task_id}}"
                      ]
                    },
                    "description": "查询单个任务详情（含 payload / result / status / thread_id / error_message）。task_id 用集合变量，调试时替换为真实 ID。"
                  },
                  "response": []
                },
                {
                  "name": "POST /tasks/{task_id}/resume 恢复人工接管任务",
                  "request": {
                    "method": "POST",
                    "header": [
                      {
                        "key": "Content-Type",
                        "value": "application/json"
                      }
                    ],
                    "body": {
                      "mode": "raw",
                      "raw": "{\n    \"decision\": \"approve\",\n    \"remark\": \"已人工处理\",\n    \"extra\": {}\n}"
                    },
                    "url": {
                      "raw": "{{base_url}}/tasks/{{task_id}}/resume",
                      "host": [
                        "{{base_url}}"
                      ],
                      "path": [
                        "tasks",
                        "{{task_id}}",
                        "resume"
                      ]
                    },
                    "description": "人工接管：恢复被 interrupt 暂停（waiting_human）的任务。\n\ndecision: approve / reject / adjust；remark 为人工备注；extra 携带人工补充信息。"
                  },
                  "response": []
                },
                {
                  "name": "GET /events 协作事件列表",
                  "request": {
                    "method": "GET",
                    "header": [],
                    "url": {
                      "raw": "{{base_url}}/events?page=1&page_size=20",
                      "host": [
                        "{{base_url}}"
                      ],
                      "path": [
                        "events"
                      ],
                      "query": [
                        {
                          "key": "event_type",
                          "value": "",
                          "disabled": true,
                          "description": "按事件类型过滤：task_failed 等（EventType 枚举）"
                        },
                        {
                          "key": "page",
                          "value": "1"
                        },
                        {
                          "key": "page_size",
                          "value": "20"
                        }
                      ]
                    },
                    "description": "协作事件分页列表（审计面板 / 事件溯源）。"
                  },
                  "response": []
                },
                {
                  "name": "GET /events/{event_id} 协作事件详情",
                  "request": {
                    "method": "GET",
                    "header": [],
                    "url": {
                      "raw": "{{base_url}}/events/{{event_id}}",
                      "host": [
                        "{{base_url}}"
                      ],
                      "path": [
                        "events",
                        "{{event_id}}"
                      ]
                    },
                    "description": "单条协作事件详情，含完整 payload。"
                  },
                  "response": []
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8866/api/admin/v1",
      "type": "string"
    },
    {
      "key": "task_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "event_id",
      "value": "1",
      "type": "string"
    }
  ]
}
